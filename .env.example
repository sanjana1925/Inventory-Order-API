# Copy to .env and adjust. Neither variable is required for local SQLite use.

# Swap to a real database by pointing this at Postgres, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/inventory
# (requires `pip install psycopg2-binary` — see requirements.txt)
DATABASE_URL=sqlite:///./inventory.db

# Signing key for JWT session tokens. Change this before deploying anywhere
# beyond localhost — the default is publicly known.
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
